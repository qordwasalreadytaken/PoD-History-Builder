import json
import time
from pathlib import Path
import random
import time

time.sleep(random.uniform(5, 15))


import requests

SEASONS = {
    9:  "20191114163730",
    10: "20200806010333",
    11: "20210301223208",
    12: "20220124001325",
}

CLASSES = [
    "amazon",
    "assassin",
    "barbarian",
    "druid",
    "necromancer",
    "paladin",
    "sorceress",
]

session = requests.Session()
session.headers.update({
    "User-Agent": "Mozilla/5.0"
})

for season, timestamp in SEASONS.items():
    season_dir = Path(f"season_{season}")
    season_dir.mkdir(exist_ok=True)

    for cls in CLASSES:
        url = (
            f"https://web.archive.org/web/{timestamp}/"
            f"https://pod-functions.azurewebsites.net/api/builds"
            f"?mode=softcore&class={cls}"
        )

        print(f"Season {season} - {cls}")

        try:
            r = session.get(url, timeout=60)
            r.raise_for_status()

            try:
                data = r.json()

                with open(
                    season_dir / f"{cls}.json",
                    "w",
                    encoding="utf-8"
                ) as f:
                    json.dump(data, f, indent=2)

                print(f"  saved {cls}.json")

            except Exception:
                print("  response was not json")
                with open(
                    season_dir / f"{cls}.html",
                    "w",
                    encoding="utf-8"
                ) as f:
                    f.write(r.text)

        except Exception as e:
            print(f"  FAILED: {e}")

        time.sleep(2)